# ==============================================================================
# ⚡ FORMAT KILAT — FRONTEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your values.
#
# IMPORTANT: every NEXT_PUBLIC_* variable is embedded in the JavaScript bundle
# and visible to anyone using the site. Never put secrets here (Box client
# secret / developer token, Gemini key, JWT secret...). Those belong in
# backend/.env and are only read by the Go gateway.

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google OAuth 2.0 Web Client ID (public by design). Must equal GOOGLE_CLIENT_ID
# on the gateway, which verifies the ID token signature and audience.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Show the unverified demo accounts (Author / Managing Editor quick sign-in).
# Must match AUTH_DEMO_LOGIN on the gateway. Set to false in production.
NEXT_PUBLIC_DEMO_LOGIN=true
