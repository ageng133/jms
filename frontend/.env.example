# ==============================================================================
# ⚡ FORMAT KILAT — FRONTEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local and fill in your credentials.

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:8080/api/v1/files

# Google OAuth 2.0 Web Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Box.com Cloud Storage Credentials
NEXT_PUBLIC_BOX_CLIENT_ID=
NEXT_PUBLIC_BOX_CLIENT_SECRET=
NEXT_PUBLIC_BOX_DEVELOPER_TOKEN=
NEXT_PUBLIC_BOX_FOLDER_ID=0
