# Server Environment
APP_ENV=development
APP_PORT=8080
APP_NAME="JMS Gateway API"
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production
JWT_EXPIRY_HOURS=72

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jms_user
POSTGRES_PASSWORD=jms_password
POSTGRES_DB=jms_db
POSTGRES_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_AUDIT_QUEUE=queue:ai_audit

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=jms-manuscripts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
