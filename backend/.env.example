# Server Environment
# APP_ENV=development enables demo login and the default demo editor account.
# Any other value (e.g. production) requires a strong JWT_SECRET and disables demo login by default.
APP_ENV=development
APP_PORT=8080
APP_NAME="JMS Gateway API"
# Gateway origin as seen from the browser (used to build upload URLs)
GATEWAY_PUBLIC_URL=http://localhost:8080
# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Max size of a single uploaded file
MAX_UPLOAD_MB=35

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production
JWT_EXPIRY_HOURS=72

# Authentication
# OAuth Web Client ID from Google Cloud Console. When set, Google ID tokens are
# verified (signature, audience, issuer, expiry) against Google's public keys.
GOOGLE_CLIENT_ID=
# Unverified email-only sign-in for demos (default: true in development, false otherwise).
# Anyone can sign in as any email while this is on. Never enable in production.
AUTH_DEMO_LOGIN=true
# Comma-separated emails provisioned as ADMIN / EDITOR on first sign-in.
# Everyone else becomes AUTHOR; roles are never taken from the client.
ADMIN_EMAILS=editor.google@uts.edu.au
EDITOR_EMAILS=

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jms_user
POSTGRES_PASSWORD=jms_password
POSTGRES_DB=jms_db
POSTGRES_SSLMODE=disable

# Storage driver: "box" (Box.com + local cache, default) or "minio"
STORAGE_DRIVER=box

# Box.com (server-side only; leave the token empty to use local disk only)
BOX_DEVELOPER_TOKEN=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_FOLDER_ID=0
BOX_LOCAL_FALLBACK_DIR=./storage/box

# Audit engines, tried in order: PyMuPDF worker, then Gemini (if a key is set).
# If none succeeds the audit is marked FAILED; no placeholder results are produced.
AUDIT_ENGINE_URL=http://127.0.0.1:8090
# Shared secret sent as X-Worker-Token (must match the worker's AUDIT_ENGINE_TOKEN)
AUDIT_ENGINE_TOKEN=
AUDIT_TIMEOUT_SECONDS=300

# Layout reshape (optional, best effort): after a successful audit the gateway runs
# scripts/remediate_pdf.py to build audits/<audit-id>_fixed_layout.pdf, shown in the
# "Before / After" comparison. A reshape failure never fails the audit.
# Empty RESHAPE_PYTHON / RESHAPE_SCRIPT = auto-detect (ai-worker .venv python and
# scripts/remediate_pdf.py from the repo root).
RESHAPE_ENABLED=true
RESHAPE_PYTHON=
RESHAPE_SCRIPT=

# Google Gemini (optional fallback engine; cannot produce an annotated PDF)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Redis (optional; only used when ENABLE_REDIS=true)
ENABLE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_AUDIT_QUEUE=queue:ai_audit

# S3 / MinIO Object Storage (only used when STORAGE_DRIVER=minio)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=jms-manuscripts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
